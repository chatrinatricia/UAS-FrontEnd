// Skema database website Kerak Telor (PostgreSQL).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

// Akun. ADMIN dipakai untuk login dashboard, USER untuk pengunjung.
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  memories     Memory[]
}

// Slide di bagian hero (tampilan awal)
model HeroSlide {
  id        Int    @id @default(autoincrement())
  title     String
  subtitle  String
  imageUrl  String
  sortOrder Int    @default(0)
}

// Isi bagian "Pengenalan". Hanya ada SATU baris (id selalu 1).
model AboutContent {
  id            Int    @id @default(1)
  title         String
  heading       String
  paragraph     String
  quote         String
  image         String
  feature1Title String
  feature1Text  String
  feature2Title String
  feature2Text  String
}

// Ulasan pengunjung (Wall of Memories). status: pending | approved | rejected
model Memory {
  userId  Int?
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  id      String   @id @default(cuid())
  nama    String
  rating  Int
  cerita  String
  status  String   @default("pending")
  tanggal DateTime @default(now())
}

// Rekomendasi tempat kerak telor
model Place {
  id       Int    @id @default(autoincrement())
  area     String
  nama     String
  alamat   String
  hargaMin Int
  hargaMax Int
  maps     String
  gambar   String
}

// Timeline sejarah. Urutan tampil mengikuti kolom "order".
model Sejarah {
  id        String   @id @default(uuid())
  era       String?
  judul     String
  deskripsi String
  gambar    String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TutorialVideo {
  slot      Int    @id
  title     String
  youtubeId String
}
